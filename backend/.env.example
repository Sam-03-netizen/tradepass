# Copy to .env and configure locally. Never commit .env.
# For local development, SQLite works without external credentials:
DATABASE_URL=sqlite:///./tradepass_dev.db
# For Supabase PostgreSQL, use the current Session Pooler URI from Supabase.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=60
STORAGE_DIR=../storage
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=10
